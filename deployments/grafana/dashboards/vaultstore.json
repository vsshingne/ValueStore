{
  "uid": "vaultstore",
  "title": "VaultStore Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Backup performance",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(backup_bytes_processed_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Worker health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "worker_active_jobs",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Storage utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "vaultstore_physical_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Kafka outbox processing",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(outbox_published_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Failures and retries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(job_attempts_total{result=\"failed\"}[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Pending outbox",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "outbox_pending_events",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Chunk reuse",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(chunks_reused_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Upload latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(chunk_upload_duration_seconds_sum[5m])/rate(chunk_upload_duration_seconds_count[5m])",
          "refId": "A"
        }
      ]
    }
  ]
}
